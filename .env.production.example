# ==============================================================================
# FASHXSTUDIO — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Injected via AWS Secrets Manager: /fashx/prod/*
# Requires passing all release, security, vendor, and catalog gates.
# ==============================================================================

ENV=prod
APP_ENV=production
APP_NAME=FashXStudio API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DATABASE_URL=<PRODUCTION_DATABASE_URL>
REDIS_URL=<PRODUCTION_REDIS_URL>

REPO_BACKEND=sql
STORAGE_BACKEND=s3

S3_BUCKET=fashx-prod-media-private
S3_REGION=ap-south-1
S3_ENDPOINT_URL=<PRODUCTION_S3_ENDPOINT>
S3_USE_IAM_ROLE=true

AUTH_MODE=jwks
AUTH_ISSUER=<PRODUCTION_AUTH_ISSUER>
AUTH_AUDIENCE=fashx-api
AUTH_JWKS_URL=<PRODUCTION_JWKS_URL>

TRYON_PROVIDER=fashn_api
FASHN_API_KEY=<INJECT_FROM_SECRET_MANAGER>
FASHN_MODEL=tryon-v1.6

VLM_PROVIDER=mock

READINESS_REQUIRES_DATABASE=true
ENABLE_B2B=false
FASHX_ENABLE_FROZEN=false

CORS_ORIGINS=["https://app.fashxstudio.com"]
SENTRY_ENVIRONMENT=production

PRIVACY_URL=https://fashxstudio.com/privacy
TERMS_URL=https://fashxstudio.com/terms

TRYON_DAILY_BUDGET_USD=50.0
TRYON_USER_DAILY_CAP=20
TRYON_WORKER_CONCURRENCY=3
