APP_ENV=development
APP_NAME=AI Fashion Assistant API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql+asyncpg://fashion:fashion@localhost:5432/fashion
REDIS_URL=redis://localhost:6379/0
READINESS_REQUIRES_DATABASE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Cloudflare R2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=900
API_BASE_URL=http://127.0.0.1:8000
WORKER_HTTP_TIMEOUT_SECONDS=15
PROFILE_PHOTO_MAX_ATTEMPTS=3
PROFILE_PHOTO_MAX_BYTES=15728640
PROFILE_PHOTO_LOCK_TIMEOUT_SECONDS=300
