{
  "expo": {
    "name": "AI Fashion Assistant",
    "slug": "ai-fashion-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aifashionassistant",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
