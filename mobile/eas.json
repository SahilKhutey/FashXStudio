{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_DEV_TOKEN_LOGIN": "1",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "true"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.fashxstudio.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.fashxstudio.com",
        "EXPO_PUBLIC_DEV_TOKEN_LOGIN": "0",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.fashxstudio.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.fashxstudio.com",
        "EXPO_PUBLIC_DEV_TOKEN_LOGIN": "0",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.fashxstudio.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.fashxstudio.com",
        "EXPO_PUBLIC_DEV_TOKEN_LOGIN": "0",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "false"
      }
    }
  }
}
