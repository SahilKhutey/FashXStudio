# ==============================================================================
# FASHXSTUDIO — SHARED DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
ENV=dev
APP_ENV=development
LOG_LEVEL=INFO
REPO_BACKEND=sql
STORAGE_BACKEND=s3
S3_REGION=ap-south-1
S3_BUCKET=fashx-dev-private-ACCOUNTID
S3_USE_IAM_ROLE=true
AUTH_MODE=jwks
AUTH_ISSUER=REPLACE_WITH_DEVELOPMENT_ISSUER
AUTH_AUDIENCE=REPLACE_WITH_DEVELOPMENT_AUDIENCE
AUTH_JWKS_URL=REPLACE_WITH_DEVELOPMENT_JWKS_URL
READINESS_REQUIRES_DATABASE=true
TRYON_PROVIDER=mock
VLM_PROVIDER=mock
ENABLE_B2B=false
FASHX_ENABLE_FROZEN=0
SENTRY_ENVIRONMENT=development
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_S=20
