{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RC00Findings",
  "type": "object",
  "required": ["findings", "generated_at", "audit"],
  "properties": {
    "generated_at": { "type": "string" },
    "audit": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "title", "subsystem"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "status": { "type": "string", "enum": ["CONFIRMED", "RISK", "UNVERIFIED", "RESOLVED", "WONT_FIX"] },
          "title": { "type": "string" },
          "subsystem": { "type": "string" },
          "evidence": { "type": "string" },
          "root_cause": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
