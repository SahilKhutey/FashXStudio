{
  "family": "fashx-${ENV}-migration",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/fashx-${ENV}-migration-execution",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/fashx-${ENV}-migrator-task",
  "containerDefinitions": [
    {
      "name": "migration",
      "image": "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/fashx:${IMAGE_TAG}",
      "essential": true,
      "command": [
        "python",
        "-m",
        "alembic",
        "upgrade",
        "head"
      ],
      "environment": [
        {"name": "ENV", "value": "${ENV}"},
        {"name": "APP_ENV", "value": "${APP_ENV}"},
        {"name": "REPO_BACKEND", "value": "sql"},
        {"name": "DB_SSL_CA_FILE", "value": "/etc/ssl/certs/aws-rds-global-bundle.pem"}
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${ACCOUNT_ID}:secret:fashx/${ENV}/postgres/migration-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/fashx/${ENV}/migration",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
