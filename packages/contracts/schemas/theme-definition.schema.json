{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modularmenu.com/contracts/theme-definition.schema.json",
  "title": "ThemeDefinition",
  "description": "Schema definition for platform-owned and registered themes in ModularMenu",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "status", "tokens", "supported_layouts", "supported_components"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^theme-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["active", "deprecated", "retired"] },
    "description": { "type": "string", "maxLength": 500 },
    "preview_image_url": { "type": "string", "format": "uri" },
    "tokens": { "$ref": "design-tokens.schema.json" },
    "supported_layouts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^layout-[a-z0-9-]+$" },
      "minItems": 1
    },
    "supported_components": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contrast_ratio_normal": { "type": "number", "minimum": 3.0 },
        "contrast_ratio_large": { "type": "number", "minimum": 3.0 },
        "wcag_level": { "type": "string", "enum": ["AA", "AAA"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
