# ==============================================================================
# FashXStudio Environment Configuration
# ==============================================================================
# Development Profile (Active Defaults)
# ==============================================================================
APP_ENV=development
ENV=dev
APP_NAME=AI Fashion Assistant API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
DATABASE_URL=postgresql+asyncpg://fashion:fashion@localhost:5432/fashion
REDIS_URL=redis://localhost:6379/0
READINESS_REQUIRES_DATABASE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional JSON feature-id overrides. Only use to disable a feature during a controlled rollout.
# FEATURE_FLAGS={"FX-F01":true,"FX-F02":false}
FASHX_ENABLE_FROZEN=0

AUTH_MODE=local
AUTH_ISSUER=fashx-local
AUTH_AUDIENCE=fashx-api
AUTH_JWT_SECRET=change-me-dev-only-32-chars-minimum
AUTH_JWKS_URL=

REPO_BACKEND=memory
TEST_DATABASE_URL=postgresql+psycopg://fashion:fashion@localhost:5432/fashx_test

STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=fashx-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_IAM_ROLE=false
SIGNED_URL_TTL_S=300
LOCAL_STORAGE_DIR=./.local_storage

TRYON_PROVIDER=mock
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
FASHN_MODEL=tryon-v1.6
FASHN_MODE=
TRYON_TIMEOUT_S=90
TRYON_MAX_ATTEMPTS=3
TRYON_USER_DAILY_CAP=20
TRYON_DAILY_BUDGET_USD=20.0
TRYON_EST_COST_USD=0.075
TRYON_WORKER_CONCURRENCY=3

PRIVACY_URL=https://fashx.studio/privacy
TERMS_URL=https://fashx.studio/terms

# ==============================================================================
# Production Profile Reference (Inject via Deployment Platform Secret Manager)
# ==============================================================================
# ENV=prod
# APP_ENV=production
# LOG_LEVEL=INFO
#
# AUTH_MODE=jwks
# AUTH_ISSUER=https://<your-tenant>.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_JWKS_URL=https://<your-tenant>.supabase.co/auth/v1/.well-known/jwks.json
#
# REPO_BACKEND=sql
# DATABASE_URL=postgresql+asyncpg://<app_user>:<app_password>@<pg_host>:5432/<pg_db>?ssl=require
# REDIS_URL=rediss://default:<redis_token>@<redis_host>:6379/0
# READINESS_REQUIRES_DATABASE=true
#
# STORAGE_BACKEND=s3
# S3_BUCKET=<private-production-bucket>
# S3_REGION=<aws-region>
# S3_USE_IAM_ROLE=true
# SIGNED_URL_TTL_S=900
#
# TRYON_PROVIDER=fashn_api
# FASHN_API_KEY=<injected-from-secret-manager>
# FASHN_BASE_URL=https://api.fashn.ai/v1
# FASHN_MODEL=tryon-v1.6
#
# CORS_ORIGINS=["https://app.fashxstudio.com"]
# PRIVACY_URL=https://fashxstudio.com/privacy
# TERMS_URL=https://fashxstudio.com/terms
# SENTRY_ENVIRONMENT=production
