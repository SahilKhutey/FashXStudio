APP_ENV=development
ENV=dev
APP_NAME=AI Fashion Assistant API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
DATABASE_URL=postgresql+asyncpg://fashion:fashion@localhost:5432/fashion
REDIS_URL=redis://localhost:6379/0
READINESS_REQUIRES_DATABASE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional JSON feature-id overrides. Only use to disable a feature during a controlled rollout.
# FEATURE_FLAGS={"FX-F01":true,"FX-F02":false}
FASHX_ENABLE_FROZEN=0

AUTH_MODE=local
AUTH_ISSUER=fashx-local
AUTH_AUDIENCE=fashx-api
AUTH_JWT_SECRET=change-me-dev-only-32-chars-minimum
AUTH_JWKS_URL=
