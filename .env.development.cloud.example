# ==============================================================================
# FASHXSTUDIO — SHARED CLOUD DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Values must be injected via the cloud secret manager (AWS Secrets Manager)
# Namespace: /fashx/dev/*
# ==============================================================================

ENV=dev
APP_ENV=development
APP_NAME=FashXStudio API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DATABASE_URL=<DEV_DATABASE_URL>
REDIS_URL=redis://fashx-redis-dev.xxxxxx.0001.aps1.cache.amazonaws.com:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

REPO_BACKEND=sql
STORAGE_BACKEND=s3

S3_BUCKET=fashx-dev-media-private
S3_REGION=ap-south-1
S3_ENDPOINT_URL=<DEV_S3_ENDPOINT>
S3_USE_IAM_ROLE=true

AUTH_MODE=jwks
AUTH_ISSUER=<DEV_AUTH_ISSUER>
AUTH_AUDIENCE=fashx-api
AUTH_JWKS_URL=<DEV_JWKS_URL>

TRYON_PROVIDER=mock
VLM_PROVIDER=mock

READINESS_REQUIRES_DATABASE=true
ENABLE_B2B=false
FASHX_ENABLE_FROZEN=false

CORS_ORIGINS=["https://dev-app.fashxstudio.com"]
SENTRY_ENVIRONMENT=development
