# ==============================================================================
# FASHXSTUDIO — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.development.example .env
# Replace AUTH_JWT_SECRET with a local-only random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

ENV=dev
APP_ENV=development
APP_NAME=FashXStudio API
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG

# Database (Local PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://fashion:fashion@127.0.0.1:5432/fashion
TEST_DATABASE_URL=postgresql+psycopg://fashion:fashion@127.0.0.1:5432/fashx_test

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# CORS Origins
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Repository and storage
REPO_BACKEND=sql
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.local_storage
READINESS_REQUIRES_DATABASE=true

# Authentication — local development only
AUTH_MODE=local
AUTH_ISSUER=fashx-local
AUTH_AUDIENCE=fashx-api
AUTH_JWT_SECRET=replace-with-a-local-random-secret-of-at-least-32-characters

# Providers (Local Mocks)
TRYON_PROVIDER=mock
VLM_PROVIDER=mock

# VTO controls
TRYON_ENABLED=true
TRYON_TIMEOUT_S=90
TRYON_MAX_ATTEMPTS=3
TRYON_USER_DAILY_CAP=20
TRYON_DAILY_BUDGET_USD=5.0
TRYON_WORKER_CONCURRENCY=1

# Features
ENABLE_B2B=false
FASHX_ENABLE_FROZEN=false

# Network / browser
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Public application links
PRIVACY_URL=http://localhost:3000/privacy
TERMS_URL=http://localhost:3000/terms
